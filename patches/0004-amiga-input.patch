+/*
+ * AmigaOS: "SetEnv SDLPOP_INPUT RAM:input.txt" logs every key, text, focus,
+ * joystick and pad event SDL gives the game, with SDL's time in ms, and the
+ * joysticks SDL finds, for lab play tests.
+ */
+static FILE* amiga_input_log;
+static int amiga_input_log_checked;
+
+static FILE* amiga_input_file(void) {
+	if (!amiga_input_log_checked) {
+		amiga_input_log_checked = 1;
+		const char* name = SDL_getenv("SDLPOP_INPUT"); // libnix's getenv does not see it
+		if (name != NULL && name[0] != '\0') amiga_input_log = fopen(name, "a");
+	}
+	return amiga_input_log;
+}
+
+void amiga_log_joysticks(const char* when) {
+	FILE* f = amiga_input_file();
+	if (f == NULL) return;
+	int n = SDL_NumJoysticks();
+	fprintf(f, "%u %s: %d joystick(s)\n", (unsigned)SDL_GetTicks(), when, n);
+	for (int i = 0; i < n; ++i) {
+		fprintf(f, "  joystick %d: \"%s\", %s\n", i, SDL_JoystickNameForIndex(i),
+		        SDL_IsGameController(i) ? "game controller" : "joystick (no controller mapping)");
+	}
+	fprintf(f, "  game uses: %s\n", !is_joyst_mode ? "keyboard" :
+	        using_sdl_joystick_interface ? "SDL_Joystick" : "SDL_GameController");
+	fflush(f);
+}
+
+static void amiga_log_event(const SDL_Event* e) {
+	FILE* f = amiga_input_file();
+	if (f == NULL) return;
+	switch (e->type) {
+		case SDL_KEYDOWN: case SDL_KEYUP:
+			fprintf(f, "%u key %s %s%s mod %04x\n", (unsigned)e->key.timestamp,
+			        SDL_GetScancodeName(e->key.keysym.scancode),
+			        e->type == SDL_KEYDOWN ? "down" : "up", e->key.repeat ? " (repeat)" : "",
+			        (unsigned)e->key.keysym.mod);
+			break;
+		case SDL_TEXTINPUT:
+			fprintf(f, "%u text \"%s\"\n", (unsigned)e->text.timestamp, e->text.text);
+			break;
+		case SDL_WINDOWEVENT:
+			if (e->window.event == SDL_WINDOWEVENT_FOCUS_GAINED) fprintf(f, "%u focus gained\n", (unsigned)e->window.timestamp);
+			else if (e->window.event == SDL_WINDOWEVENT_FOCUS_LOST) fprintf(f, "%u focus lost\n", (unsigned)e->window.timestamp);
+			else return;
+			break;
+		case SDL_CONTROLLERBUTTONDOWN: case SDL_CONTROLLERBUTTONUP:
+			fprintf(f, "%u pad button %s %s\n", (unsigned)e->cbutton.timestamp,
+			        SDL_GameControllerGetStringForButton(e->cbutton.button),
+			        e->type == SDL_CONTROLLERBUTTONDOWN ? "down" : "up");
+			break;
+		case SDL_CONTROLLERAXISMOTION:
+			fprintf(f, "%u pad axis %s %d\n", (unsigned)e->caxis.timestamp,
+			        SDL_GameControllerGetStringForAxis(e->caxis.axis), e->caxis.value);
+			break;
+		case SDL_JOYBUTTONDOWN: case SDL_JOYBUTTONUP:
+			fprintf(f, "%u joy button %d %s\n", (unsigned)e->jbutton.timestamp, e->jbutton.button,
+			        e->type == SDL_JOYBUTTONDOWN ? "down" : "up");
+			break;
+		case SDL_JOYAXISMOTION:
+			fprintf(f, "%u joy axis %d %d\n", (unsigned)e->jaxis.timestamp, e->jaxis.axis, e->jaxis.value);
+			break;
+		case SDL_JOYHATMOTION:
+			fprintf(f, "%u joy hat %d %d\n", (unsigned)e->jhat.timestamp, e->jhat.hat, e->jhat.value);
+			break;
+		case SDL_JOYDEVICEADDED: case SDL_CONTROLLERDEVICEADDED:
+			fprintf(f, "%u %s added %d\n", (unsigned)e->jdevice.timestamp,
+			        e->type == SDL_JOYDEVICEADDED ? "joystick" : "controller", e->jdevice.which);
+			break;
+		case SDL_JOYDEVICEREMOVED: case SDL_CONTROLLERDEVICEREMOVED:
+			fprintf(f, "%u %s removed %d\n", (unsigned)e->jdevice.timestamp,
+			        e->type == SDL_JOYDEVICEREMOVED ? "joystick" : "controller", e->jdevice.which);
+			break;
+		default:
+			return;
+	}
+	fflush(f);
+}
+
+/*
+ * AmigaOS pads: the fire button is the game's Shift (grab, sword, careful
+ * step) and the second button jumps, so a one-button stick or a CD32 pad
+ * plays it. Through SDL_GameController (GFOpenInput's standard layout,
+ * where red is A and blue is B): A acts as X and B as Y; X and Y and the
+ * d-pad stay as upstream has them, and down is the d-pad's or the stick's.
+ * Through SDL_Joystick (lowlevel.library: 0 red, 1 blue, 2 green, 3 yellow,
+ * 4 play, 5 forward, 6 reverse): red as X, blue as Y, play opens the menu;
+ * green and yellow keep upstream's numbers (2 Y, 3 X).
+ */
+static int amiga_controller_button(int b) {
+	if (b == SDL_CONTROLLER_BUTTON_A) return SDL_CONTROLLER_BUTTON_X;
+	if (b == SDL_CONTROLLER_BUTTON_B) return SDL_CONTROLLER_BUTTON_Y;
+	return b;
+}
+static int amiga_joystick_button(int b) {
+	if (b == 0) return SDL_JOYSTICK_BUTTON_X;
+	if (b == 1) return SDL_JOYSTICK_BUTTON_Y;
+	return b;
+}
