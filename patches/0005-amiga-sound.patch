+#ifdef __amigaos__
+#undef audio_callback
+/*
+ * AmigaOS, with the "fps" option: every five seconds, how many buffers the
+ * mixer filled, how many of those callbacks came more than half a buffer
+ * late (SDL's AHI driver asks for the next buffer as the last one starts
+ * playing), and the time the mixing took (sound effects, the OPL3 music
+ * synthesis of midi.c, Ogg music when there is any).
+ */
+static volatile dword amiga_audio_buffers, amiga_audio_late;
+static volatile Uint64 amiga_audio_mix, amiga_audio_mix_max, amiga_audio_last;
+
+void audio_callback(void* userdata, Uint8* stream, int len) {
+	Uint64 freq = SDL_GetPerformanceFrequency();
+	Uint64 start = SDL_GetPerformanceCounter();
+	if (digi_audiospec != NULL && amiga_audio_last != 0) {
+		int frame_bytes = digi_audiospec->channels * (SDL_AUDIO_BITSIZE(digi_audiospec->format) / 8);
+		double buffer_s = (double)len / frame_bytes / digi_audiospec->freq;
+		if ((double)(start - amiga_audio_last) / freq > buffer_s * 1.5) ++amiga_audio_late;
+	}
+	amiga_audio_last = start;
+	audio_callback_mix(userdata, stream, len);
+	Uint64 spent = SDL_GetPerformanceCounter() - start;
+	amiga_audio_mix += spent;
+	if (spent > amiga_audio_mix_max) amiga_audio_mix_max = spent;
+	++amiga_audio_buffers;
+}
+
+// from the main thread (the "fps" log): the counts so far, then from zero
+void amiga_audio_log(void) {
+	if (digi_audiospec == NULL) return;
+	SDL_LockAudio();
+	dword buffers = amiga_audio_buffers, late = amiga_audio_late;
+	Uint64 mix = amiga_audio_mix, mix_max = amiga_audio_mix_max;
+	amiga_audio_buffers = amiga_audio_late = 0;
+	amiga_audio_mix = amiga_audio_mix_max = 0;
+	SDL_UnlockAudio();
+	double f = (double)SDL_GetPerformanceFrequency();
+	printf("audio %u buffers, %u late, mixing %.2f ms a buffer (max %.2f) at %.3f s\n",
+	       (unsigned)buffers, (unsigned)late, buffers ? 1000.0 * mix / f / buffers : 0.0,
+	       1000.0 * mix_max / f, SDL_GetTicks() / 1000.0);
+	fflush(stdout);
+}
+#endif
+
