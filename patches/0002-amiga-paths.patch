 const char* find_first_file_match(char* dst, int size, char* format, const char* filename) {
+#ifdef __amigaos__
+	// AmigaOS: the program's drawer is the current directory (main.c), and
+	// "DIR/NAME" would not do for it: "PROGDIR:/NAME" is the parent drawer.
+	snprintf_check(dst, size, "%s", filename);
+	return (const char*) dst;
+#endif
 	find_exe_dir();
 #if defined WIN32 || _WIN32 || WIN64 || _WIN64
 	snprintf_check(dst, size, format, exe_dir, filename);
@@ -116,6 +122,13 @@ const char* find_first_file_match(char* dst, int size, char* format, const char*
 }
 
 const char* locate_save_file_(const char* filename, char* dst, int size) {
+#ifdef __amigaos__
+	// AmigaOS: what the game writes goes in the drawer User beside the
+	// program (PROGDIR:User), made when it is first needed.
+	mkdir(AMIGA_USER_DIR, 0700);
+	snprintf_check(dst, size, "%s/%s", AMIGA_USER_DIR, filename);
+	return (const char*) dst;
+#endif
 	find_exe_dir();
 #if defined WIN32 || _WIN32 || WIN64 || _WIN64
 	snprintf_check(dst, size, "%s/%s", exe_dir, filename);
