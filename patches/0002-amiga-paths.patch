diff --git a/src/main.c b/src/main.c
index 7779c88..c83cd74 100644
--- a/src/main.c
+++ b/src/main.c
@@ -33,10 +33,30 @@ static const char stack[] = "$STACK:200000";
 #include <psppower.h>
 #endif
 
+#ifdef __amigaos__
+__attribute__((used)) static const char amiga_version[] = "$VER: SDLPoP " SDLPOP_VERSION " (AmiCradle, 68040+FPU)";
+static char amiga_self[POP_MAX_PATH];
+#endif
+
 int main(int argc, char *argv[])
 {
 #ifdef __amigaos__
 	chdir("PROGDIR:");
+	/*
+	 * AmigaOS: the files beside the program are found in the current
+	 * directory (PROGDIR:, set above), and argv[0] is the command as typed,
+	 * which need not name the program from there. The executable's own
+	 * checksum (SDLPoP.cfg, menu.c) reads argv[0], so it becomes
+	 * PROGDIR:NAME.
+	 */
+	if (argc >= 1 && argv[0] != NULL) {
+		const char* name = argv[0];
+		for (const char* p = argv[0]; *p; ++p) {
+			if (*p == '/' || *p == ':') name = p + 1;
+		}
+		snprintf(amiga_self, sizeof(amiga_self), "PROGDIR:%s", name);
+		argv[0] = amiga_self;
+	}
 #endif
 	#ifdef __PSP__
 	scePowerSetClockFrequency(333,333,166);
