+#ifdef __amigaos__
+// AmigaOS, with the "fps" option: every second, how many game frames were
+// played (play_frame, seg000.c) and how many times the screen was updated,
+// and what an update cost
+dword amiga_game_frames;
+static int amiga_fps_log = -1;
+static dword amiga_updates;
+static Uint64 amiga_update_counts, amiga_update_max, amiga_log_from;
+
+static void amiga_frame_log(Uint64 started) {
+	Uint64 now = SDL_GetPerformanceCounter();
+	Uint64 spent = now - started;
+	Uint64 freq = SDL_GetPerformanceFrequency();
+	++amiga_updates;
+	amiga_update_counts += spent;
+	if (spent > amiga_update_max) amiga_update_max = spent;
+	if (amiga_log_from == 0) amiga_log_from = now;
+	if (now - amiga_log_from >= freq) {
+		double secs = (double)(now - amiga_log_from) / freq;
+		printf("fps game %.1f, screen %.1f, update %.2f ms (max %.2f) at %.3f s\n",
+		       amiga_game_frames / secs, amiga_updates / secs,
+		       1000.0 * amiga_update_counts / freq / amiga_updates,
+		       1000.0 * amiga_update_max / freq, SDL_GetTicks() / 1000.0);
+		fflush(stdout);
+		amiga_game_frames = amiga_updates = 0;
+		amiga_update_counts = amiga_update_max = 0;
+		amiga_log_from = now;
+	}
+}
+#endif
+
 void update_screen() {
+#ifdef __amigaos__
+	if (amiga_fps_log < 0) amiga_fps_log = check_param("fps") != NULL;
+	Uint64 amiga_started = amiga_fps_log ? SDL_GetPerformanceCounter() : 0;
+#endif
 	draw_overlay();
 	SDL_Surface* surface = get_final_surface();
 	init_scaling();
@@ -2802,6 +2868,9 @@ void update_screen() {
 	SDL_RenderClear(renderer_);
 	SDL_RenderCopy(renderer_, target_texture, NULL, NULL);
 	SDL_RenderPresent(renderer_);
+#ifdef __amigaos__
+	if (amiga_fps_log) amiga_frame_log(amiga_started);
+#endif
 }
 
